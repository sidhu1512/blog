---
interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
const encodedTitle = encodeURIComponent(title);
const encodedUrl = encodeURIComponent(url);

const twitterUrl = `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`;
const linkedinUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
const whatsappUrl = `https://api.whatsapp.com/send?text=${encodedTitle}%0A%0A${encodedUrl}`;
---

<div class="share-buttons">
  <span class="share-label">Share this article</span>
  <div class="share-icons">
    <!-- WhatsApp -->
    <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="share-btn share-whatsapp" aria-label="Share on WhatsApp">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.159.57 4.184 1.564 5.939l-1.564 5.717 5.864-1.538c1.691.921 3.63 1.458 5.698 1.458 6.627 0 12-5.373 12-12s-5.373-12-12-12zm0 21.6c-1.877 0-3.627-.528-5.12-1.444l-.367-.224-3.484.914.93-3.394-.246-.391c-1.008-1.603-1.543-3.473-1.543-5.461 0-5.293 4.307-9.6 9.6-9.6s9.6 4.307 9.6 9.6-4.307 9.6-9.6 9.6z"/>
      </svg>
      <span>WhatsApp</span>
    </a>

    <!-- Twitter / X -->
    <a href={twitterUrl} target="_blank" rel="noopener noreferrer" class="share-btn share-twitter" aria-label="Share on Twitter / X">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
      </svg>
      <span>Twitter</span>
    </a>

    <!-- LinkedIn -->
    <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="share-btn share-linkedin" aria-label="Share on LinkedIn">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
      </svg>
      <span>LinkedIn</span>
    </a>

    <!-- Copy Link -->
    <button class="share-btn copy-link-btn" data-url={url} data-title={title} aria-label="Copy article link">
      <svg class="copy-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
      </svg>
      <svg class="check-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
      <span class="copy-link-text">Copy Link</span>
    </button>
  </div>
</div>

<style>
  .share-buttons {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .share-label {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--foreground);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .share-icons {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.1rem;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 500;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--muted-foreground);
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: var(--font-body);
  }
  .share-btn:hover {
    color: var(--foreground);
    border-color: var(--accent);
    background: #202024;
    transform: translateY(-1px);
  }
  .share-whatsapp:hover {
    color: #25D366;
    border-color: #25D366;
    background: rgba(37, 211, 102, 0.08);
  }
  .share-twitter:hover {
    color: #38bdf8;
    border-color: #38bdf8;
    background: rgba(56, 189, 248, 0.08);
  }
  .share-linkedin:hover {
    color: #0a66c2;
    border-color: #0a66c2;
    background: rgba(10, 102, 194, 0.08);
  }
  .share-btn.copied {
    color: #10b981;
    border-color: #10b981;
    background: rgba(16, 185, 129, 0.08);
  }
</style>

<script>
  function initShareButtons() {
    const copyBtn = document.querySelector('.copy-link-btn');
    if (!copyBtn) return;

    copyBtn.addEventListener('click', async () => {
      const shareUrl = copyBtn.getAttribute('data-url') || window.location.href;
      const shareTitle = copyBtn.getAttribute('data-title') || document.title;
      const copyIcon = copyBtn.querySelector('.copy-icon') as HTMLElement | null;
      const checkIcon = copyBtn.querySelector('.check-icon') as HTMLElement | null;
      const textEl = copyBtn.querySelector('.copy-link-text');

      // Native mobile share sheet if on mobile phone
      if (navigator.share && /Android|iPhone|iPad|iPod/i.test(navigator.userAgent)) {
        try {
          await navigator.share({
            title: shareTitle,
            url: shareUrl,
          });
          return;
        } catch {
          // Fallback to clipboard on dismissal
        }
      }

      try {
        await navigator.clipboard.writeText(shareUrl);
        if (copyIcon) copyIcon.style.display = 'none';
        if (checkIcon) checkIcon.style.display = 'inline';
        if (textEl) textEl.textContent = 'Link Copied!';
        copyBtn.classList.add('copied');

        setTimeout(() => {
          if (copyIcon) copyIcon.style.display = 'inline';
          if (checkIcon) checkIcon.style.display = 'none';
          if (textEl) textEl.textContent = 'Copy Link';
          copyBtn.classList.remove('copied');
        }, 2200);
      } catch (err) {
        console.error('Clipboard copy failed', err);
      }
    });
  }

  initShareButtons();
  document.addEventListener('astro:page-load', initShareButtons);
</script>
