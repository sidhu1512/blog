---
import ThemeToggle from './ThemeToggle.astro';

const pathname = new URL(Astro.request.url).pathname;
const base = import.meta.env.BASE_URL;
// ensure base doesn't mess up matching
const normalizedPath = pathname.endsWith('/') ? pathname.slice(0, -1) : pathname;
const normalizedBase = base.endsWith('/') ? base.slice(0, -1) : base;
---
<header class="header">
  <div class="header-container">
    <a href="https://sidhu1512.github.io/blog/" class="logo">
      Siddharth.
    </a>
    <div class="header-right">
      <nav>
        <a href="https://sidhu1512.github.io/" class="nav-btn">Portfolio</a>
        <a href={base} class={`nav-btn ${normalizedPath === normalizedBase ? 'active' : ''}`}>Blog</a>
        <a href={`${normalizedBase}/tags`} class={`nav-btn ${normalizedPath === `${normalizedBase}/tags` ? 'active' : ''}`}>Topics</a>
        <a href={`${normalizedBase}/about`} class={`nav-btn ${normalizedPath === `${normalizedBase}/about` ? 'active' : ''}`}>About</a>
      </nav>
      <div class="divider"></div>
      <button id="search-trigger" class="search-trigger" aria-label="Search (Ctrl+K)" title="Search (Ctrl+K)">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="search-kbd">Ctrl K</span>
      </button>
      <div class="divider"></div>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--border);
    padding: 1rem 0;
    position: sticky;
    top: 0;
    background: var(--header-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 100;
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }
  .header-container {
    max-width: 86rem;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  @media (min-width: 1280px) {
    .header-container {
      padding: 0 3rem;
    }
  }
  .logo {
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.8rem;
    color: var(--foreground);
    transition: color 0.2s;
  }
  .logo:hover {
    color: var(--accent);
  }
  .header-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  nav {
    display: flex;
    gap: 0.4rem;
  }
  .divider {
    width: 1px;
    height: 20px;
    background: var(--border);
    margin: 0 0.25rem;
  }
  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--muted-foreground);
    padding: 0.35rem 0.7rem;
    border-radius: 8px;
    cursor: pointer;
    font-family: var(--font-body);
    transition: all 0.2s ease;
  }
  .search-trigger:hover {
    color: var(--foreground);
    border-color: var(--accent);
  }
  .search-kbd {
    font-family: monospace;
    font-size: 0.7rem;
    letter-spacing: 0.03em;
  }
  @media (max-width: 640px) {
    .search-kbd {
      display: none;
    }
  }
  .nav-btn {
    text-decoration: none;
    color: var(--muted-foreground);
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.4rem 0.8rem;
    border-radius: 6px;
    transition: all 0.2s;
  }
  .nav-btn:hover, .nav-btn.active {
    color: var(--foreground);
    background: var(--surface);
  }
</style>
