---
/**
 * ThemePicker — Curated deuterium-grade visual themes dropdown.
 * Updates data-skin on <html> without layout shifts or text flicker.
 */
interface Props {
  position?: 'top' | 'bottom';
}
const { position = 'top' } = Astro.props;
import skins from '../theme-skins/skins.json';
---

<div class="theme-picker" data-position={position}>
  <details class="theme-menu">
    <summary class="theme-menu-summary" aria-label="Choose a theme" title="Visual Themes">
      <svg class="theme-menu-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 2a10 10 0 1 0 10 10"></path>
        <path d="M12 2a10 10 0 0 1 10 10"></path>
        <path d="M2 12h10"></path>
      </svg>
      <span class="theme-menu-label">Theme</span>
      <span class="theme-current-badge" aria-live="polite">RPN Garden</span>
    </summary>
    <div class="theme-menu-panel">
      <label class="theme-panel-label" for="header-theme-select">Select visual skin</label>
      <select id="header-theme-select" class="theme-select" aria-label="Choose a theme">
        {skins.map((s) => <option value={s.id}>{s.name}</option>)}
      </select>
    </div>
  </details>
</div>

<style>
  .theme-picker {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .theme-menu {
    position: relative;
  }

  .theme-menu-summary {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--muted-foreground);
    height: 36px;
    padding: 0 0.65rem;
    border-radius: 8px;
    cursor: pointer;
    list-style: none;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
    user-select: none;
    font-size: 0.85rem;
    font-family: var(--font-body), system-ui, sans-serif;
  }
  .theme-menu-summary::-webkit-details-marker {
    display: none;
  }

  .theme-menu-summary:hover {
    color: var(--foreground);
    border-color: var(--accent);
    background: var(--surface-raised);
  }
  .theme-menu[open] .theme-menu-summary {
    color: var(--foreground);
    border-color: var(--accent);
  }

  .theme-menu-icon {
    flex-shrink: 0;
    color: var(--accent);
  }

  .theme-menu-label {
    font-weight: 500;
  }

  .theme-current-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    color: var(--accent);
    padding: 0.12rem 0.45rem;
    border-radius: 4px;
    max-width: 7.5rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    display: inline-block;
  }

  .theme-menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    width: 230px;
    z-index: 120;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .theme-panel-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted-foreground);
  }

  .theme-select {
    width: 100%;
    background: var(--surface);
    color: var(--foreground);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.5rem 0.6rem;
    font-family: var(--font-body), system-ui, sans-serif;
    font-size: 16px;
    cursor: pointer;
    outline: none;
    transition: border-color 0.15s;
  }
  .theme-select:focus-visible {
    border-color: var(--accent);
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
</style>

<script>
  import skins from '../theme-skins/skins.json';

  const defaultSkinId = 'rpn-garden';
  const root = document.documentElement;

  function updateThemeUI(skinId: string) {
    const sel = document.getElementById('header-theme-select') as HTMLSelectElement | null;
    if (sel) sel.value = skinId;

    const badge = document.querySelector('.theme-current-badge');
    const skinObj = skins.find((s) => s.id === skinId);
    const skinName = skinObj ? skinObj.name : 'RPN Garden';
    if (badge) badge.textContent = skinName;
  }

  function initHeaderThemePicker() {
    const select = document.getElementById('header-theme-select') as HTMLSelectElement | null;
    const details = document.querySelector('.theme-menu') as HTMLDetailsElement | null;

    const currentSkin = root.getAttribute('data-skin') || defaultSkinId;
    updateThemeUI(currentSkin);

    if (select && (select as any)._bound !== true) {
      (select as any)._bound = true;
      select.addEventListener('change', () => {
        const id = select.value;
        if (id === defaultSkinId || !id) {
          root.removeAttribute('data-skin');
        } else {
          root.setAttribute('data-skin', id);
        }
        try {
          localStorage.setItem('theme-skin', id);
        } catch {}
        updateThemeUI(id);
        if (details) details.open = false;
      });
    }

    // Dismiss details menu on outside click
    if (!(window as any)._themeMenuOutsideBound) {
      (window as any)._themeMenuOutsideBound = true;
      document.addEventListener('click', (e) => {
        const menu = document.querySelector('.theme-menu[open]') as HTMLDetailsElement | null;
        if (menu && !menu.contains(e.target as Node)) {
          menu.open = false;
        }
      });
    }
  }

  initHeaderThemePicker();
  document.addEventListener('astro:page-load', initHeaderThemePicker);

  // Sync when skin changes from floating dock or other controls
  const observer = new MutationObserver(() => {
    const active = root.getAttribute('data-skin') || defaultSkinId;
    updateThemeUI(active);
  });
  observer.observe(root, { attributes: true, attributeFilter: ['data-skin'] });
</script>