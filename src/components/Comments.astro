---
/**
 * Comments — GitHub Discussions-backed comments via giscus.
 *
 * ┌─ ONE-TIME SETUP ────────────────────────────────────────────────────────┐
 * │ 1. Enable Discussions on the repo that hosts this blog.                │
 * │ 2. Install the giscus app: https://github.com/apps/giscus              │
 * │ 3. Go to https://giscus.app, enter the repo, pick a category           │
 * │    (recommend "Announcements" so only maintainers open threads).       │
 * │ 4. Copy the generated values into the constants below.                 │
 * └────────────────────────────────────────────────────────────────────────┘
 *
 * Until configured, the widget renders nothing — the section simply stays hidden.
 */
const GISCUS_REPO = 'sidhu1512/blog';
const GISCUS_REPO_ID = 'R_kgDOSOOinw';
const GISCUS_CATEGORY = 'Announcements';
const GISCUS_CATEGORY_ID = 'DIC_kwDOSOOin84DFkIM';

const configured = Boolean(GISCUS_REPO && GISCUS_REPO_ID && GISCUS_CATEGORY_ID);
---

{configured && (
  <div class="comments-section">
    <h2 class="comments-title">Comments</h2>
    <div
      id="giscus-container"
      class="comments-widget"
      data-repo={GISCUS_REPO}
      data-repo-id={GISCUS_REPO_ID}
      data-category={GISCUS_CATEGORY}
      data-category-id={GISCUS_CATEGORY_ID}
    >
    </div>
  </div>
)}

<style>
  .comments-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .comments-title {
    font-size: 1.5rem;
    margin-top: 0;
    margin-bottom: 1.25rem;
  }
  .comments-widget :global(.giscus) {
    max-width: 100%;
  }
</style>

<script>
  const GISCUS_SRC = 'https://giscus.app/client.js';

  function giscusTheme(): string {
    return document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
  }

  function mountGiscus() {
    const container = document.getElementById('giscus-container');
    if (!container || (container as any).__giscusBound) return;
    (container as any).__giscusBound = true;

    const script = document.createElement('script');
    script.src = GISCUS_SRC;
    script.async = true;
    script.crossOrigin = 'anonymous';
    script.setAttribute('data-repo', container.dataset.repo ?? '');
    script.setAttribute('data-repo-id', container.dataset.repoId ?? '');
    script.setAttribute('data-category', container.dataset.category ?? 'Announcements');
    script.setAttribute('data-category-id', container.dataset.categoryId ?? '');
    script.setAttribute('data-mapping', 'pathname');
    script.setAttribute('data-strict', '0');
    script.setAttribute('data-reactions-enabled', '1');
    script.setAttribute('data-emit-metadata', '0');
    script.setAttribute('data-input-position', 'top');
    script.setAttribute('data-theme', giscusTheme());
    script.setAttribute('data-lang', 'en');
    script.setAttribute('data-loading', 'lazy');
    container.appendChild(script);
  }

  // Keep the widget's theme in sync when the user toggles light/dark.
  // Delegated document-level listener survives view-transition DOM swaps.
  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest?.('#theme-toggle')) {
      const iframe = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
      iframe?.contentWindow?.postMessage(
        { giscus: { setConfig: { theme: giscusTheme() } } },
        'https://giscus.app'
      );
    }
  });

  mountGiscus();
  document.addEventListener('astro:page-load', mountGiscus);
</script>
