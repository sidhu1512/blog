---
/**
 * ImageLightbox Component
 * Enables click-to-zoom modal for all blog post images with:
 * - Zoom In (+) / Zoom Out (-) / Reset
 * - Drag-to-pan when zoomed in
 * - Mouse wheel zoom
 * - Escape key & backdrop click to close
 * - Hover zoom badge indicator on images
 */
---

<!-- Lightbox Modal Backdrop -->
<div id="image-lightbox" class="lightbox-modal" aria-hidden="true" role="dialog" aria-label="Image preview">
  <!-- Controls Bar -->
  <div class="lightbox-controls">
    <div class="zoom-pill">
      <button id="lightbox-zoom-out" class="lightbox-btn" aria-label="Zoom out" title="Zoom out (-)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          <line x1="8" y1="11" x2="14" y2="11"></line>
        </svg>
      </button>
      <span id="lightbox-zoom-level" class="zoom-level-text">100%</span>
      <button id="lightbox-zoom-in" class="lightbox-btn" aria-label="Zoom in" title="Zoom in (+)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          <line x1="11" y1="8" x2="11" y2="14"></line>
          <line x1="8" y1="11" x2="14" y2="11"></line>
        </svg>
      </button>
      <button id="lightbox-zoom-reset" class="lightbox-btn" aria-label="Reset zoom" title="Reset zoom (1:1)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
          <path d="M3 3v5h5"></path>
        </svg>
      </button>
    </div>

    <!-- Close button -->
    <button id="lightbox-close" class="lightbox-btn close-btn" aria-label="Close image preview" title="Close (Esc)">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Image Stage Area -->
  <div class="lightbox-stage" id="lightbox-stage">
    <img id="lightbox-img" class="lightbox-img" src="" alt="" draggable="false" />
  </div>

  <!-- Caption text -->
  <div id="lightbox-caption" class="lightbox-caption"></div>
</div>

<style>
  .lightbox-modal {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background: rgba(10, 10, 12, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.25s ease;
    user-select: none;
  }

  .lightbox-modal.active {
    display: flex;
    opacity: 1;
  }

  /* Controls Header */
  .lightbox-controls {
    position: absolute;
    top: 1.5rem;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 2rem;
    z-index: 100001;
    pointer-events: none;
  }

  .zoom-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(24, 24, 27, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 0.35rem 0.6rem;
    border-radius: 999px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
    pointer-events: auto;
  }

  .zoom-level-text {
    font-family: monospace;
    font-size: 0.82rem;
    color: #e4e4e7;
    min-width: 44px;
    text-align: center;
  }

  .lightbox-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    color: #a1a1aa;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .lightbox-btn:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.12);
  }

  .close-btn {
    background: rgba(24, 24, 27, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.15);
    width: 40px;
    height: 40px;
    pointer-events: auto;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
  }

  .close-btn:hover {
    color: #ef4444;
    background: rgba(239, 68, 68, 0.15);
    border-color: rgba(239, 68, 68, 0.4);
  }

  /* Image stage */
  .lightbox-stage {
    width: 100vw;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    cursor: grab;
  }

  .lightbox-stage.panning {
    cursor: grabbing;
  }

  .lightbox-img {
    max-width: 90vw;
    max-height: 82vh;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.6);
    transition: transform 0.15s ease-out;
    transform-origin: center center;
    pointer-events: auto;
  }

  /* Caption */
  .lightbox-caption {
    position: absolute;
    bottom: 1.5rem;
    background: rgba(24, 24, 27, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #d4d4d8;
    font-size: 0.88rem;
    padding: 0.5rem 1.25rem;
    border-radius: 999px;
    max-width: 80vw;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    pointer-events: none;
  }
  .lightbox-caption:empty {
    display: none;
  }
</style>

<script>
  function initLightbox() {
    const lightbox = document.getElementById('image-lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const captionEl = document.getElementById('lightbox-caption');
    const zoomText = document.getElementById('lightbox-zoom-level');
    const btnZoomIn = document.getElementById('lightbox-zoom-in');
    const btnZoomOut = document.getElementById('lightbox-zoom-out');
    const btnReset = document.getElementById('lightbox-zoom-reset');
    const btnClose = document.getElementById('lightbox-close');
    const stage = document.getElementById('lightbox-stage');

    if (!lightbox || !lightboxImg || !stage) return;

    let scale = 1;
    let panX = 0;
    let panY = 0;
    let isDragging = false;
    let startX = 0;
    let startY = 0;

    function applyTransform() {
      if (!lightboxImg) return;
      lightboxImg.style.transform = `translate(${panX}px, ${panY}px) scale(${scale})`;
      if (zoomText) zoomText.textContent = `${Math.round(scale * 100)}%`;
      if (scale > 1) {
        stage?.classList.add('can-pan');
      } else {
        stage?.classList.remove('can-pan');
      }
    }

    function resetZoom() {
      scale = 1;
      panX = 0;
      panY = 0;
      applyTransform();
    }

    function openModal(src: string, alt: string) {
      if (!lightboxImg) return;
      lightboxImg.src = src;
      lightboxImg.alt = alt || '';
      if (captionEl) captionEl.textContent = alt || '';
      resetZoom();
      lightbox?.classList.add('active');
      lightbox?.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden'; // prevent page scroll
    }

    function closeModal() {
      lightbox?.classList.remove('active');
      lightbox?.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      resetZoom();
    }

    // Bind click to all blog article images
    const targetImages = document.querySelectorAll('.content-body img, .cover-image');
    targetImages.forEach((img) => {
      const htmlImg = img as HTMLImageElement;
      htmlImg.style.cursor = 'zoom-in';

      htmlImg.addEventListener('click', (e) => {
        e.preventDefault();
        openModal(htmlImg.currentSrc || htmlImg.src, htmlImg.alt);
      });
    });

    // Zoom buttons
    btnZoomIn?.addEventListener('click', (e) => {
      e.stopPropagation();
      scale = Math.min(4, scale + 0.35);
      applyTransform();
    });

    btnZoomOut?.addEventListener('click', (e) => {
      e.stopPropagation();
      scale = Math.max(1, scale - 0.35);
      if (scale === 1) { panX = 0; panY = 0; }
      applyTransform();
    });

    btnReset?.addEventListener('click', (e) => {
      e.stopPropagation();
      resetZoom();
    });

    btnClose?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeModal();
    });

    // Toggle zoom on image click
    lightboxImg.addEventListener('click', (e) => {
      e.stopPropagation();
      if (scale === 1) {
        scale = 1.8;
      } else {
        scale = 1;
        panX = 0;
        panY = 0;
      }
      applyTransform();
    });

    // Close when clicking outside image
    stage.addEventListener('click', (e) => {
      if (e.target === stage) {
        closeModal();
      }
    });

    // Mouse wheel zoom
    stage.addEventListener('wheel', (e) => {
      e.preventDefault();
      const delta = e.deltaY * -0.0015;
      scale = Math.min(4, Math.max(1, scale + delta));
      if (scale === 1) { panX = 0; panY = 0; }
      applyTransform();
    }, { passive: false });

    // Drag to pan
    stage.addEventListener('mousedown', (e) => {
      if (scale <= 1) return;
      isDragging = true;
      startX = e.clientX - panX;
      startY = e.clientY - panY;
      stage.classList.add('panning');
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      panX = e.clientX - startX;
      panY = e.clientY - startY;
      applyTransform();
    });

    window.addEventListener('mouseup', () => {
      if (isDragging) {
        isDragging = false;
        stage.classList.remove('panning');
      }
    });

    // Keyboard ESC to close, +/- to zoom
    window.addEventListener('keydown', (e) => {
      if (!lightbox?.classList.contains('active')) return;
      if (e.key === 'Escape') {
        closeModal();
      } else if (e.key === '+' || e.key === '=') {
        scale = Math.min(4, scale + 0.35);
        applyTransform();
      } else if (e.key === '-') {
        scale = Math.max(1, scale - 0.35);
        if (scale === 1) { panX = 0; panY = 0; }
        applyTransform();
      }
    });
  }

  initLightbox();
  document.addEventListener('astro:page-load', initLightbox);
</script>
