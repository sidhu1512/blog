---
---
<div class="memory-widget liquid-glass">
  <div class="mem-header">
    <h4>VRAM Allocation Tracker</h4>
    <span class="status pulse">Active Inference</span>
  </div>
  <div class="gauge-container">
    <div class="gauge-bg"></div>
    <div id="gauge-fill" class="gauge-fill" style="width: 0%"></div>
  </div>
  <div class="mem-stats">
    <span>Allocated: <strong id="mem-val">0</strong> GB</span>
    <span>Total: 24 GB</span>
  </div>
</div>

<style>
  .memory-widget { padding: 1.5rem; margin: 2rem 0; border-left: 4px solid var(--accent); }
  .mem-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
  .mem-header h4 { margin: 0; font-family: var(--font-body); font-weight: 600; font-size: 1.1rem; }
  .status { font-size: 0.8rem; font-family: monospace; text-transform: uppercase; letter-spacing: 1px; color: var(--accent); }
  .pulse { animation: pulse 2s infinite; }
  @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.5; } 100% { opacity: 1; } }
  .gauge-container { height: 24px; background: var(--surface); border: 1px solid var(--border); border-radius: 4px; overflow: hidden; margin-bottom: 1rem; position: relative; }
  .gauge-fill { height: 100%; background: linear-gradient(90deg, #4CAF50, var(--accent), #F44336); transition: width 0.3s ease; width: 0%; }
  .mem-stats { display: flex; justify-content: space-between; font-size: 0.85rem; font-family: monospace; color: var(--muted-foreground); }
</style>

<script>
  const gaugeFill = document.getElementById('gauge-fill');
  const memVal = document.getElementById('mem-val');
  
  if (gaugeFill && memVal) {
    let currentMem = 2;
    setInterval(() => {
      // Simulate memory loading from 2GB to 18GB, fluctuating slightly
      const target = Math.min(23, Math.max(2, currentMem + (Math.random() * 4 - 1.5)));
      currentMem = currentMem + (target - currentMem) * 0.1;
      const pct = (currentMem / 24) * 100;
      gaugeFill.style.width = `${pct}%`;
      memVal.textContent = currentMem.toFixed(1);
    }, 500);
  }
</script>
