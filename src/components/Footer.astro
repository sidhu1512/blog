---
const currentYear = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer-container">
    <p>&copy; {currentYear} Siddharth Bhadu. All rights reserved.</p>
    <div class="socials">
      <a href="https://github.com/sidhu1512" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="https://www.linkedin.com/in/siddharth-bhadu-71a483193" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href="/blog/rss.xml" target="_blank">RSS</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 2rem 0;
    margin-top: 4rem;
  }
  .footer-container {
    max-width: 86rem;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--muted-foreground);
    font-size: 0.85rem;
  }
  @media (min-width: 1280px) {
    .footer-container {
      padding: 0 3rem;
    }
  }
  .socials {
    display: flex;
    gap: 1rem;
  }
  .socials a {
    text-decoration: none;
    color: var(--muted-foreground);
  }
  .socials a:hover {
    color: var(--accent);
  }
  @media (max-width: 480px) {
    .footer-container {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
    }
  }
</style>
