---
export interface Props {
  title: string;
  description: string;
  image?: string;
  url?: string;
  type?: 'website' | 'article';
  pubDate?: Date | string;
  updatedDate?: Date | string;
  tags?: string[];
}

const { 
  title, 
  description, 
  image,
  url,
  type = 'website',
  pubDate,
  updatedDate,
  tags = []
} = Astro.props;

const siteOrigin = 'https://sidhu1512.github.io';
const base = '/blog';

// Resolve absolute canonical URL for scrapers (WhatsApp, Twitter, LinkedIn, Facebook)
function getCanonicalUrl(): string {
  if (url) {
    if (url.startsWith('http://') || url.startsWith('https://')) return url;
    let clean = url.replace(/^\//, '');
    if (clean.startsWith('blog/')) clean = clean.slice(5);
    return `${siteOrigin}${base}/${clean}`;
  }
  const pathname = Astro.url.pathname;
  let cleanPath = pathname.replace(/^\//, '');
  if (!cleanPath.startsWith('blog')) {
    cleanPath = `blog/${cleanPath}`;
  }
  return `${siteOrigin}/${cleanPath.replace(/\/$/, '')}/`;
}

// Resolve absolute image URL for WhatsApp / social previews
function getAbsoluteImageUrl(img?: string): string {
  if (!img) return `${siteOrigin}${base}/images/encoder-decoder.png`;
  if (img.startsWith('http://') || img.startsWith('https://')) return img;
  
  let cleanPath = img.replace(/^\//, '');
  if (cleanPath.startsWith('blog/')) {
    cleanPath = cleanPath.slice(5);
  }
  return `${siteOrigin}${base}/${cleanPath}`;
}

const canonicalUrl = getCanonicalUrl();
const absoluteImageUrl = getAbsoluteImageUrl(image);
const publishedTime = pubDate ? (pubDate instanceof Date ? pubDate.toISOString() : new Date(pubDate).toISOString()) : undefined;

// JSON-LD structured data for rich search results
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': type === 'article' ? 'BlogPosting' : 'WebSite',
  ...(type === 'article'
    ? {
        headline: title,
        description,
        image: absoluteImageUrl,
        url: canonicalUrl,
        datePublished: publishedTime,
        ...(updatedDate ? { dateModified: updatedDate instanceof Date ? updatedDate.toISOString() : new Date(updatedDate).toISOString() } : {}),
        author: {
          '@type': 'Person',
          name: 'Siddharth Bhadu',
          url: 'https://sidhu1512.github.io/',
        },
        keywords: tags.length > 0 ? tags.join(', ') : undefined,
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
      }
    : {
        name: 'Siddharth Bhadu - Engineering Blog',
        url: canonicalUrl,
        description,
        author: {
          '@type': 'Person',
          name: 'Siddharth Bhadu',
          url: 'https://sidhu1512.github.io/',
        },
      }),
};
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph / WhatsApp / Facebook / LinkedIn -->
<meta property="og:site_name" content="Siddharth Bhadu - Engineering Blog" />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteImageUrl} />
<meta property="og:image:secure_url" content={absoluteImageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />

{publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{type === 'article' && (
  <meta property="article:author" content="Siddharth Bhadu" />
)}
{tags.map((tag: string) => (
  <meta property="article:tag" content={tag} />
))}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImageUrl} />
<meta name="twitter:image:alt" content={title} />

<!-- Structured data for rich search results -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
