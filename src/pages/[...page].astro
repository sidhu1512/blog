---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths({ paginate }) {
  const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  // Paginate 3 posts per page
  return paginate(posts, { pageSize: 3 });
}

const { page } = Astro.props;
const base = import.meta.env.BASE_URL;
const normalizedBase = base.endsWith('/') ? base : `${base}/`;
---
<Layout title="Siddharth Bhadu - Engineering Blog" description="Engineering notes on custom kernels, local inference, and hardware design.">
  <div class="hero">
    <h1>Engineering notes.</h1>
    <p class="subtitle">Thoughts on software, hardware, and building things that scale.</p>
  </div>
  <div class="posts-grid">
    {
      page.data.map((post) => (
        <a href={`${normalizedBase}${post.id}`} class="post-card liquid-glass">
          {post.data.heroImage ? (
            <div class="card-image-wrapper">
              <img src={post.data.heroImage} alt="" class="card-image" />
            </div>
          ) : (
            <div class="card-image-wrapper fallback-image">
               <!-- Abstract placeholder if no image -->
            </div>
          )}
          <div class="card-content">
            <span class="post-date">
              <time datetime={post.data.pubDate.toISOString()}>
                {
                  post.data.pubDate.toLocaleDateString('en-us', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })
                }
              </time>
            </span>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </div>
        </a>
      ))
    }
  </div>

  <div class="pagination">
    {page.url.prev ? <a href={page.url.prev} class="nav-btn">&larr; Previous</a> : <span></span>}
    <span class="page-num">Page {page.currentPage} of {page.lastPage}</span>
    {page.url.next ? <a href={page.url.next} class="nav-btn">Next &rarr;</a> : <span></span>}
  </div>
</Layout>

<style>
  .hero { margin-bottom: 4rem; }
  .subtitle { font-size: 1.2rem; color: var(--muted-foreground); }
  .posts-grid { display: flex; flex-direction: column; gap: 2rem; }
  
  .post-card { display: flex; flex-direction: column; text-decoration: none; color: inherit; transition: transform 0.2s ease, border-color 0.2s ease; overflow: hidden; background: var(--surface); }
  .post-card:hover { transform: translateY(-3px); border-color: var(--accent); }
  @media(min-width: 640px) {
    .post-card { flex-direction: row; align-items: stretch; }
  }
  
  .card-image-wrapper { flex: 0 0 35%; overflow: hidden; border-bottom: 1px solid var(--border); }
  @media(min-width: 640px) {
    .card-image-wrapper { border-bottom: none; border-right: 1px solid var(--border); }
  }
  .card-image { width: 100%; height: 100%; object-fit: cover; margin: 0; border: none; border-radius: 0; min-height: 200px; }
  
  .fallback-image {
    background: repeating-linear-gradient(45deg, var(--surface), var(--surface) 10px, var(--border) 10px, var(--border) 20px);
    min-height: 200px;
  }

  .card-content { padding: 1.5rem; flex: 1; display: flex; flex-direction: column; justify-content: center; }
  
  .post-date { font-family: monospace; font-size: 0.85rem; color: var(--accent); display: block; margin-bottom: 0.5rem; }
  .post-card h3 { margin-top: 0; margin-bottom: 0.5rem; color: var(--foreground); text-decoration: none; font-size: 1.5rem; }
  .post-card p { margin-bottom: 0; font-size: 0.95rem; color: var(--muted-foreground); }
  
  .pagination { display: flex; justify-content: space-between; align-items: center; margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--border); }
  .nav-btn { background: var(--surface); color: var(--foreground); padding: 0.5rem 1rem; border-radius: 6px; text-decoration: none; border: 1px solid var(--border); font-size: 0.9rem; transition: background 0.2s; }
  .nav-btn:hover { background: var(--border); }
  .page-num { color: var(--muted-foreground); font-family: monospace; font-size: 0.9rem; }
</style>
