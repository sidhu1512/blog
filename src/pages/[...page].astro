---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths({ paginate }) {
  const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  // Paginate 6 posts per page for a balanced grid
  return paginate(posts, { pageSize: 6 });
}

const { page } = Astro.props;
const base = import.meta.env.BASE_URL;
const normalizedBase = base.endsWith('/') ? base : `${base}/`;

// Helper to compute reading time for card
function getReadingTime(body: string = '') {
  const words = body.split(/\s+/).length || 0;
  return Math.max(1, Math.ceil(words / 200));
}

function getAssetUrl(path?: string) {
  if (!path) return '';
  if (path.startsWith('http://') || path.startsWith('https://')) return path;
  if (path.startsWith(normalizedBase)) return path;
  return `${normalizedBase}${path.replace(/^\//, '')}`;
}
---
<Layout title="Siddharth Bhadu - Engineering Blog" description="Engineering notes on custom kernels, local inference, and hardware design.">
  <div class="hero">
    <div class="hero-badge">Engineering & Systems</div>
    <h1>Engineering notes.</h1>
    <p class="subtitle">Thoughts on software architecture, hardware acceleration, and building high-performance systems.</p>
  </div>

  <div class="posts-grid">
    {
      page.data.map((post) => {
        const readingTime = getReadingTime(post.body);
        return (
          <article class="post-card-container">
            <a href={`${normalizedBase}${post.id}`} class="post-card liquid-glass">
              {post.data.heroImage ? (
                <div class="card-image-wrapper">
                  <img src={getAssetUrl(post.data.heroImage)} alt="" class="card-image" loading="lazy" />
                </div>
              ) : (
                <div class="card-image-wrapper fallback-image">
                  <div class="fallback-pattern"></div>
                </div>
              )}
              <div class="card-content">
                <div class="card-meta">
                  <time datetime={post.data.pubDate.toISOString()} class="card-date">
                    {
                      post.data.pubDate.toLocaleDateString('en-us', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                      })
                    }
                  </time>
                  <span class="meta-separator">•</span>
                  <span class="card-read-time">{readingTime} min read</span>
                </div>

                <h2 class="card-title">{post.data.title}</h2>
                <p class="card-desc">{post.data.description}</p>

                <div class="card-footer">
                  {post.data.tags?.length > 0 && (
                    <div class="card-tags">
                      {post.data.tags.map((tag: string) => (
                        <span class="card-tag">#{tag}</span>
                      ))}
                    </div>
                  )}
                  <span class="read-more">Read post &rarr;</span>
                </div>
              </div>
            </a>
          </article>
        );
      })
    }
  </div>

  {page.lastPage > 1 && (
    <nav class="pagination" aria-label="Pagination">
      {page.url.prev ? <a href={page.url.prev} class="nav-btn">&larr; Previous</a> : <span />}
      <span class="page-num">Page {page.currentPage} of {page.lastPage}</span>
      {page.url.next ? <a href={page.url.next} class="nav-btn">Next &rarr;</a> : <span />}
    </nav>
  )}
</Layout>

<style>
  .hero {
    margin-bottom: 3.5rem;
  }
  .hero-badge {
    display: inline-block;
    font-family: monospace;
    font-size: 0.75rem;
    color: var(--accent);
    background: rgba(234, 179, 8, 0.1);
    border: 1px solid rgba(234, 179, 8, 0.25);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .hero h1 {
    margin-top: 0;
    margin-bottom: 0.75rem;
    font-size: 3.5rem;
  }
  .subtitle {
    font-size: 1.2rem;
    color: var(--muted-foreground);
    max-width: 38rem;
    line-height: 1.6;
    margin-bottom: 0;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  
  .post-card-container {
    display: flex;
  }

  .post-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
  }

  .post-card:hover {
    transform: translateY(-4px);
    border-color: rgba(234, 179, 8, 0.5);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
  }

  @media (min-width: 768px) {
    .post-card {
      flex-direction: row;
      align-items: stretch;
    }
  }

  .card-image-wrapper {
    flex: 0 0 34%;
    height: 250px;
    overflow: hidden;
    position: relative;
    border-bottom: 1px solid var(--border);
    background: #111216;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem;
  }

  @media (min-width: 768px) {
    .card-image-wrapper {
      border-bottom: none;
      border-right: 1px solid var(--border);
      height: auto;
      min-height: 250px;
      max-width: 320px;
    }
  }

  .card-image {
    max-width: 100%;
    max-height: 220px;
    width: auto;
    height: auto;
    object-fit: contain;
    margin: auto;
    border: none;
    border-radius: 6px;
    transition: transform 0.3s ease;
  }

  .post-card:hover .card-image {
    transform: scale(1.04);
  }

  .fallback-image {
    min-height: 220px;
    height: 100%;
    background: #131316;
    position: relative;
  }

  .fallback-pattern {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 12px,
      rgba(255, 255, 255, 0.02) 12px,
      rgba(255, 255, 255, 0.02) 24px
    );
  }

  .card-content {
    padding: 1.75rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .card-date {
    font-family: monospace;
    font-size: 0.85rem;
    color: var(--accent);
  }

  .meta-separator {
    color: var(--border);
    font-size: 0.75rem;
  }

  .card-read-time {
    font-family: monospace;
    font-size: 0.8rem;
    color: var(--muted-foreground);
  }

  .card-title {
    margin-top: 0;
    margin-bottom: 0.75rem;
    color: var(--foreground);
    font-size: 1.6rem;
    line-height: 1.3;
    transition: color 0.2s ease;
  }

  .post-card:hover .card-title {
    color: #ffffff;
  }

  .card-desc {
    margin-bottom: 1.25rem;
    font-size: 0.95rem;
    color: var(--muted-foreground);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .card-tag {
    font-size: 0.75rem;
    font-family: monospace;
    color: var(--muted-foreground);
    background: var(--background);
    border: 1px solid var(--border);
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    transition: all 0.2s;
  }

  .read-more {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    transition: transform 0.2s ease;
  }

  .post-card:hover .read-more {
    transform: translateX(4px);
  }

  .pagination {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .nav-btn {
    background: var(--surface);
    color: var(--foreground);
    padding: 0.55rem 1.1rem;
    border-radius: 8px;
    text-decoration: none;
    border: 1px solid var(--border);
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.2s;
  }

  .nav-btn:hover {
    background: var(--border);
    border-color: var(--accent);
  }

  .page-num {
    color: var(--muted-foreground);
    font-family: monospace;
    font-size: 0.9rem;
  }
</style>
