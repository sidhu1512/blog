---
import '../styles/global.css';
// Self-hosted fonts (no Google Fonts CDN — faster first paint, GDPR-clean)
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
// KaTeX styles for math rendering
import 'katex/dist/katex.min.css';

import { ClientRouter } from 'astro:transitions';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import SearchModal from '../components/SearchModal.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date | string;
  updatedDate?: Date | string;
  tags?: string[];
}

const { 
  title, 
  description, 
  image, 
  type = 'website',
  pubDate,
  updatedDate,
  tags = []
} = Astro.props;

const base = import.meta.env.BASE_URL;
const normalizedBase = base.endsWith('/') ? base : `${base}/`;

function resolveAssetUrl(path?: string) {
  if (!path) return undefined;
  if (path.startsWith('http://') || path.startsWith('https://')) return path;
  if (path.startsWith(normalizedBase)) return path;
  return `${normalizedBase}${path.replace(/^\//, '')}`;
}

const resolvedImage = resolveAssetUrl(image);
const faviconUrl = `${normalizedBase}favicon.svg`;
const rssUrl = `${normalizedBase}rss.xml`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- Theme initialization script (runs immediately to prevent FOUC) -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
            return;
          }
          const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
          const initialTheme = prefersLight ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', initialTheme);
        } catch {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>

    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <meta name="generator" content={Astro.generator} />
    <link rel="alternate" type="application/rss+xml" title="Siddharth Bhadu - Engineering Blog" href={rssUrl} />
    <ClientRouter />
    <SEO 
      title={title} 
      description={description} 
      image={resolvedImage} 
      type={type} 
      pubDate={pubDate} 
      updatedDate={updatedDate}
      tags={tags} 
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <ImageLightbox />
    <SearchModal />

    <script>
      // Delegated click handler for tag chips nested inside clickable cards
      // (spans with data-tag-link inside <a> post cards)
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const tagEl = target.closest('[data-tag-link]') as HTMLElement | null;
        if (!tagEl || !tagEl.dataset.tagLink) return;
        e.preventDefault();
        e.stopPropagation();
        window.location.href = tagEl.dataset.tagLink;
      });
    </script>
  </body>
</html>
