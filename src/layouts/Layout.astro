---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date | string;
  tags?: string[];
}

const { 
  title, 
  description, 
  image, 
  type = 'website',
  pubDate,
  tags = []
} = Astro.props;

const base = import.meta.env.BASE_URL;
const normalizedBase = base.endsWith('/') ? base : `${base}/`;

function resolveAssetUrl(path?: string) {
  if (!path) return undefined;
  if (path.startsWith('http://') || path.startsWith('https://')) return path;
  if (path.startsWith(normalizedBase)) return path;
  return `${normalizedBase}${path.replace(/^\//, '')}`;
}

const resolvedImage = resolveAssetUrl(image);
const faviconUrl = `${normalizedBase}favicon.svg`;
const rssUrl = `${normalizedBase}rss.xml`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="alternate" type="application/rss+xml" title="Siddharth Bhadu - Engineering Blog" href={rssUrl} />
    <SEO 
      title={title} 
      description={description} 
      image={resolvedImage} 
      type={type} 
      pubDate={pubDate} 
      tags={tags} 
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
