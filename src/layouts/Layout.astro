---
import '../styles/global.css';
import '../styles/themes.css';
// Self-hosted fonts (no Google Fonts CDN — faster first paint, GDPR-clean)
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
// Display fonts used by individual theme skins
import '@fontsource/space-grotesk/latin-500.css';
import '@fontsource/space-grotesk/latin-600.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/latin-500-italic.css';
import '@fontsource/fraunces/latin-500.css';
import '@fontsource/fraunces/latin-600.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-600.css';
import '@fontsource/syne/latin-600.css';
import '@fontsource/bebas-neue/latin-400.css';
// KaTeX styles for math rendering
import 'katex/dist/katex.min.css';

import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';

import skins from '../theme-skins/skins.json';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import SearchModal from '../components/SearchModal.astro';
import MobileBottomBar from '../components/MobileBottomBar.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date | string;
  updatedDate?: Date | string;
  tags?: string[];
}

const { 
  title, 
  description, 
  image, 
  type = 'website',
  pubDate,
  updatedDate,
  tags = []
} = Astro.props;

const skinIds = skins.map((s) => s.id);

// All post slugs, exposed as JSON for the command palette's /random jump
const allPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((p) => p.id);

const base = import.meta.env.BASE_URL;
const normalizedBase = base.endsWith('/') ? base : `${base}/`;

function resolveAssetUrl(path?: string) {
  if (!path) return undefined;
  if (path.startsWith('http://') || path.startsWith('https://')) return path;
  if (path.startsWith(normalizedBase)) return path;
  return `${normalizedBase}${path.replace(/^\//, '')}`;
}

const resolvedImage = resolveAssetUrl(image);
const faviconUrl = `${normalizedBase}favicon.svg`;
const rssUrl = `${normalizedBase}rss.xml`;
---

<!DOCTYPE html>
<html lang="en" data-theme="dark" data-skins={skinIds.join(' ')}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- Theme initialization script (runs immediately to prevent FOUC) -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            root.setAttribute('data-theme', stored);
          } else {
            root.setAttribute(
              'data-theme',
              window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'
            );
          }
          const skin = localStorage.getItem('theme-skin');
          const valid = (root.dataset.skins || '').split(/\s+/);
          if (skin && valid.includes(skin)) {
            root.setAttribute('data-skin', skin);
          }
        } catch {
          root.setAttribute('data-theme', 'dark');
        }
      })();
    </script>

    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <meta name="generator" content={Astro.generator} />
    <script type="application/json" id="posts-json" set:html={JSON.stringify(allPosts)}></script>
    <link rel="alternate" type="application/rss+xml" title="Siddharth Bhadu - Engineering Blog" href={rssUrl} />
    <ClientRouter />
    <SEO 
      title={title} 
      description={description} 
      image={resolvedImage} 
      type={type} 
      pubDate={pubDate} 
      updatedDate={updatedDate}
      tags={tags} 
    />
  </head>
  <body>
    <!-- Astro's view-transition swap copies the incoming page's <html> attributes,
         which drops data-theme/data-skin. Re-apply the stored prefs right after every swap. -->
    <script>
      document.addEventListener('astro:after-swap', () => {
        const root = document.documentElement;
        let theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        root.setAttribute('data-theme', theme);
        let skin = null;
        try {
          skin = localStorage.getItem('theme-skin');
        } catch {}
        const valid = (root.dataset.skins || '').split(/\s+/);
        if (skin && valid.includes(skin)) {
          root.setAttribute('data-skin', skin);
        } else {
          root.removeAttribute('data-skin');
        }
      });
    </script>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <ImageLightbox />
    <SearchModal />
    <MobileBottomBar />

    <script>
      // Delegated handler for tag chips nested inside clickable post cards.
      // Runs in the CAPTURE phase so it wins the race against the card link's
      // own document-level listener (the Astro ClientRouter intercepts normal
      // clicks and soft-navigates), then soft-navigates to the tag page.
      let astroNavigate: ((href: string) => void) | undefined;
      import('astro:transitions/client').then((m) => (astroNavigate = m.navigate)).catch(() => {});
      document.addEventListener(
        'click',
        (e) => {
          try {
            const tagEl = (e.target as HTMLElement).closest('[data-tag-link]') as HTMLElement | null;
            if (!tagEl || !tagEl.dataset.tagLink) return;
            e.preventDefault();
            e.stopPropagation();
            if (astroNavigate) {
              astroNavigate(tagEl.dataset.tagLink);
            } else {
              window.location.assign(tagEl.dataset.tagLink);
            }
          } catch {}
        },
        true
      );
    </script>
  </body>
</html>
